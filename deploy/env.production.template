# این فایل رو روی «سرور» به /var/www/shop/.env کپی کن و مقدارها رو پر کن. هیچ‌وقت داخل git نره.

# دیتابیس (روی همون سرور)
DATABASE_URL="postgresql://shop_user:DB_PASSWORD@localhost:5432/shop"

# کلید امضای ورود (JWT) — با این بسازش:  openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
AUTH_SECRET="PUT_RANDOM_SECRET_HERE"

# آدرس سایت (برای درگاه پرداخت، سئو و sitemap)
SITE_URL="https://supermarketrahimi.ir"
# کد تأیید Google Search Console (فقط مقدار content تگ meta)
GOOGLE_SITE_VERIFICATION=""
TRUSTED_PROXY_COUNT=1

# پیامک (روی production حتماً smsir یا kavenegar؛ console کار نمی‌کنه)
SMS_PROVIDER="smsir"
SMSIR_API_KEY=""
SMSIR_OTP_TEMPLATE_ID=""
SMSIR_OTP_PARAM_NAME="CODE"
SMSIR_OTP_TIME_PARAM_NAME="TIME"
# اگه کاوه‌نگار می‌خوای: SMS_PROVIDER="kavenegar" و دو مقدار پایین
KAVENEGAR_API_KEY=""
KAVENEGAR_OTP_TEMPLATE=""

# پرداخت آنلاین (مرچنت‌کد زرین‌پال). PAYMENT_SANDBOX رو روی production خالی بذار.
ZARINPAL_MERCHANT_ID=""
PAYMENT_SANDBOX=

# اعلان پوش (با npm run generate-vapid بساز)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# اختیاری: تأیید خودکار تحویل با cron
CRON_SECRET=""
