# ───────────── دیتابیس (PostgreSQL روی VPS) ─────────────
# اگه از طریق SSH tunnel وصل می‌شی (مثلاً: ssh -N -L 5433:localhost:5432 user@vps) همین localhost:5433 درسته.
# اگه مستقیم به IP سرور وصل می‌شی حتماً ?sslmode=require اضافه کن و پورت 5432 رو فقط برای IP خودت باز کن.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/DBNAME"

# ───────────── احراز هویت ─────────────
# کلید امضای JWT — حداقل ۳۲ کاراکتر، تصادفی، و هیچ‌وقت توی git نره. برای ساختنش:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# (توی سرور production یه کلید «جدا» بساز؛ با عوض‌کردنش همه از حساب‌شون بیرون می‌افتن.)
AUTH_SECRET="CHANGE_ME_RANDOM_48_BYTES"

# ───────────── پیامک OTP ─────────────
# console   → فقط توسعه: کد توی ترمینال چاپ می‌شه و توی صفحه‌ی ورود هم نشون داده می‌شه (پیامکی نمی‌ره)
# smsir     → ارسال واقعی با «ارسال سریع» سامانه‌ی sms.ir
# kavenegar → ارسال واقعی با «Verify Lookup» کاوه‌نگار
# ⚠️ روی Vercel (Settings → Environment Variables) مقدارها رو «بدون کوتیشن» و بدون فاصله/اینتر وارد کن (kavenegar نه "kavenegar").
# ⚠️ روی production مقدار console کار نمی‌کنه و ورود با خطای «ارسال پیامک با مشکل مواجه شد» برمی‌گرده؛ باید smsir (یا kavenegar) باشه.
SMS_PROVIDER="console"

# فقط برای smsir:
#  ۱) کلید API: پنل sms.ir ← «برنامه‌نویسان» ← «لیست کلیدهای API»
#  ۲) شناسه‌ی قالب: پنل ← «برنامه‌نویسان» ← «لیست قالب‌ها» ← ستون «شناسه قالب» (فقط عدد)
#     ⚠️ قالب باید «تأیید شده» باشه؛ تا وضعیتش «در حال بررسی» هست ارسال با خطا برمی‌گرده (توی این مدت از console استفاده کن).
#  ۳) اسم پارامتر: همون اسمی که توی متن قالب بین #...# نوشتی. مثلاً متن «کد ورود شما: #CODE#» ← CODE
#  ۴) اگه توی پنل sms.ir «محدودیت IP» برای کلید API فعاله، IP سرورت رو اضافه کن (یا روی Vercel خاموشش کن؛ IP توابع Vercel ثابت نیست).
SMSIR_API_KEY=""
SMSIR_OTP_TEMPLATE_ID=""
SMSIR_OTP_PARAM_NAME="CODE"
# پارامتر مدت اعتبار (#TIME# توی متن قالب). اگه قالبت نداره، این خط رو بذار خالی: SMSIR_OTP_TIME_PARAM_NAME=""
SMSIR_OTP_TIME_PARAM_NAME="TIME"
# فقط برای kavenegar: توی پنل کاوه‌نگار یه الگو (template) بساز که متنش «%token» داشته باشه
# مثلاً: «کد ورود شما به سوپرمارکت رحیمی: %token»
KAVENEGAR_API_KEY=""
KAVENEGAR_OTP_TEMPLATE=""
# اگه توی پنل کاوه‌نگار «محدودیت IP» فعاله، روی Vercel خاموشش کن (IP توابع Vercel ثابت نیست).

# ───────────── نقشه و آدرس (اختیاری) ─────────────
# سرور تبدیل مختصات به آدرس (سازگار با Nominatim). پیش‌فرض: سرور عمومی OpenStreetMap (فقط برای ترافیک کم)
# GEOCODE_URL="https://nominatim.openstreetmap.org/reverse"
# GEOCODE_USER_AGENT="sopermarket-shop/1.0 (you@example.com)"
# کاشی‌های نقشه. برای production یه سرویس مناسب یا سرور خودت رو بذار (NEXT_PUBLIC یعنی توی مرورگر هم دیده می‌شه)
# NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
# NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap"

# ── پرداخت آنلاین ──────────────────────────────────────────────
# مرچنت‌کد زرین‌پال؛ اگه پر باشه پرداخت واقعی با زرین‌پال انجام می‌شه.
ZARINPAL_MERCHANT_ID=
# آدرس اصلی سایت (برای callback درگاه + سئو: canonical، sitemap.xml، robots.txt و تگ‌های OG). حتماً ست کن، مثلاً https://example.com
# (بدون ست‌شدنش، لینک‌های sitemap و canonical روی localhost ساخته می‌شن و گوگل سایت رو درست ایندکس نمی‌کنه)
SITE_URL=
# فقط برای تست روی سرور بدون مرچنت‌کد: درگاه آزمایشی (/pay/sandbox) رو توی production هم فعال می‌کنه (۱ = فعال)
# در محیط توسعه (npm run dev) بدون مرچنت‌کد، درگاه آزمایشی خودکار فعاله.
PAYMENT_SANDBOX=
# تعداد پروکسی‌های جلوی برنامه (برای تشخیص IP واقعی در rate-limit؛ جلوی جعل هدر X-Forwarded-For رو می‌گیره).
# فقط nginx → ۱ (پیش‌فرض)؛ Cloudflare + nginx → ۲؛ روی Vercel → ۱
TRUSTED_PROXY_COUNT=1

# ── تأیید خودکار تحویل (اختیاری) ──────────────────────────────
# اگه پر باشه، /api/cron/auto-deliver با هدر «Authorization: Bearer <این مقدار>» قابل صدا زدنه (مثلاً هر ساعت با cron سرور).
# بدون cron هم کار می‌کنه: صفحه‌ی سفارش‌های ادمین و پنل مشتری خودشون هر دقیقه یک‌بار چک می‌کنن.
CRON_SECRET=

# ── اتصال دیتابیس روی Vercel (اختیاری) ──────────────────────────
# حداکثر اتصال هر instance به Postgres (پیش‌فرض ۳). DATABASE_URL نباید localhost باشه؛ آدرس/پورت قابل‌دسترس از اینترنت بده.
# DB_POOL_MAX=3

# ── اعلان‌های پوش (موبایل و لپ‌تاپ، حتی با سایت بسته) ─────────────
# یک‌بار «npm run generate-vapid» رو اجرا کن و خروجی‌اش رو اینجا بذار. بدون این‌ها فقط اعلان درون‌سایت (SSE) کار می‌کنه.
# کلید خصوصی رو هیچ‌وقت توی git نذار. VAPID_SUBJECT یه ایمیل یا آدرس سایت خودته.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:you@example.com"
